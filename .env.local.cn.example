# World Monitor CN fork local template
# Copy to .env.local and fill your own values.
# Do NOT commit real secrets.

# -------------------------
# Variant
# -------------------------
VITE_VARIANT=full

# -------------------------
# RSS tuning (no-relay baseline)
# -------------------------
RSS_DIGEST_FEED_TIMEOUT_MS=9000
RSS_DIGEST_OVERALL_DEADLINE_MS=32000
RSS_DIGEST_BATCH_CONCURRENCY=12
RSS_PROXY_EXTRA_DOMAINS=
RSS_APNEWS_FALLBACK=1
RSS_APNEWS_FALLBACK_URL=https://rsshub.app/apnews

# -------------------------
# Relay (Round-1 target)
# -------------------------
WS_RELAY_URL=
VITE_WS_RELAY_URL=
RELAY_SHARED_SECRET=
RELAY_AUTH_HEADER=x-relay-key
VITE_OPENSKY_RELAY_URL=

# -------------------------
# Round-2 required keys
# -------------------------
UCDP_ACCESS_TOKEN=
FRED_API_KEY=

# -------------------------
# Recommended keys
# -------------------------
FINNHUB_API_KEY=
EIA_API_KEY=

# -------------------------
# Optional feeds/providers
# -------------------------
GROQ_API_KEY=
OPENROUTER_API_KEY=
NASA_FIRMS_API_KEY=
AISSTREAM_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
WINGBITS_API_KEY=
AVIATIONSTACK_API=
ICAO_API_KEY=
